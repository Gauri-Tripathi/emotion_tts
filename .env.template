# ============================================================
# LLM Agent Configuration
# Copy this to .env and fill in your values
# ============================================================

# Active provider: ollama | vllm | openai | gemini | anthropic
LLM_PROVIDER=openai

# --- Model names (per provider) ---
LLM_MODEL_OLLAMA=qwen3:1.7b
LLM_MODEL_VLLM=Qwen/Qwen2.5-1.5B-Instruct
LLM_MODEL_OPENAI=gpt-4o-mini
LLM_MODEL_GEMINI=gemini-2.5-flash
LLM_MODEL_ANTHROPIC=claude-sonnet-4-20250514

# --- API hosts (only change if non-default) ---
# LLM_API_HOST_OLLAMA=http://127.0.0.1:11434/v1
# LLM_API_HOST_VLLM=http://127.0.0.1:5000/v1
# LLM_API_HOST_OPENAI=https://api.openai.com/v1
# LLM_API_HOST_GEMINI=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_HOST_ANTHROPIC=https://api.anthropic.com/v1

# --- API keys ---
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# --- Generation params ---
LLM_TEMPERATURE=0.1
LLM_TOP_P=0.5
LLM_MAX_TOKENS=2048

# --- Logging ---
LOG_LEVEL=INFO
